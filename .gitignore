# Spring Initializr 안내 파일
HELP.md

# Gradle 빌드 산출물과 로컬 캐시
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# Spring Tool Suite 로컬 설정
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

# IntelliJ IDEA 로컬 설정과 컴파일 산출물
.idea/
*.iws
*.iml
*.ipr
out/
!**/src/main/**/out/
!**/src/test/**/out/

# NetBeans 로컬 설정과 산출물
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# VS Code 로컬 설정
.vscode/

# 로컬 환경 변수와 비밀값
.env
.env.*
!.env.example

# 로그와 JVM 오류 덤프
*.log
*.hprof
hs_err_pid*

# 운영체제가 생성하는 파일
.DS_Store
Thumbs.db

# 개인 작업 컨텍스트 파일 (로컬 전용, 브랜치 전환/커밋에 영향받지 않음)
CLAUDE.md
CODEX.md
